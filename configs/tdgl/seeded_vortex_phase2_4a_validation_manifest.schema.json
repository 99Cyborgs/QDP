{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeededVortexPhase24AValidationManifest",
  "type": "object",
  "required": [
    "schema_version",
    "validation_id",
    "claim_scope",
    "experiment_pack",
    "expected_results"
  ],
  "properties": {
    "schema_version": {
      "const": "tdgl_rf.seeded_vortex_phase2_4a_validation.v1"
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1
    },
    "experiment_pack": {
      "type": "string",
      "minLength": 1
    },
    "expected_results": {
      "type": "object",
      "required": [
        "top_level",
        "parameter_points",
        "members"
      ],
      "properties": {
        "top_level": {
          "$ref": "#/$defs/top_level"
        },
        "parameter_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parameter_point"
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "observable_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "aggregate_metrics": {
      "type": "object",
      "required": [
        "mean",
        "std",
        "min",
        "max"
      ],
      "properties": {
        "mean": { "type": "number" },
        "std": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "aggregate_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/aggregate_metrics"
      }
    },
    "robustness_observable": {
      "type": "object",
      "required": [
        "coefficient_of_variation",
        "coefficient_of_variation_defined",
        "sign_consistency",
        "successful_member_count"
      ],
      "properties": {
        "coefficient_of_variation": { "type": ["number", "null"] },
        "coefficient_of_variation_defined": { "type": "boolean" },
        "sign_consistency": { "type": "number" },
        "successful_member_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "robustness_summary": {
      "type": "object",
      "required": [
        "failed_member_count",
        "failure_rate",
        "member_count",
        "observables",
        "successful_member_count"
      ],
      "properties": {
        "failed_member_count": { "type": "integer", "minimum": 0 },
        "failure_rate": { "type": "number" },
        "member_count": { "type": "integer", "minimum": 1 },
        "observables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/robustness_observable"
          }
        },
        "successful_member_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "seed_payload": {
      "type": "object",
      "required": [
        "seed_index",
        "winding",
        "x0",
        "y0"
      ],
      "properties": {
        "core_radius": { "type": ["number", "null"] },
        "seed_index": { "type": "integer", "minimum": 0 },
        "winding": { "type": "integer" },
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "plaquette_x": { "type": "integer", "minimum": 0 },
        "plaquette_y": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "top_level": {
      "type": "object",
      "required": [
        "mode",
        "pack_name",
        "parent_manifest_hash",
        "expected_member_count",
        "parameter_point_count",
        "run_count",
        "overall_status"
      ],
      "properties": {
        "mode": { "const": "stochastic_ensemble" },
        "pack_name": { "type": "string", "minLength": 1 },
        "parent_manifest_hash": { "type": "string", "minLength": 1 },
        "expected_member_count": { "type": "integer", "minimum": 1 },
        "parameter_point_count": { "type": "integer", "minimum": 1 },
        "run_count": { "type": "integer", "minimum": 1 },
        "overall_status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "parameter_point": {
      "type": "object",
      "required": [
        "param_set_hash",
        "ensemble_id",
        "parameters",
        "case_class",
        "run_count",
        "successful_run_count",
        "member_indices",
        "noise_seeds",
        "aggregates",
        "robustness_summary"
      ],
      "properties": {
        "param_set_hash": { "type": "string", "minLength": 1 },
        "ensemble_id": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "minProperties": 1, "additionalProperties": true },
        "case_class": { "type": "string", "minLength": 1 },
        "run_count": { "type": "integer", "minimum": 1 },
        "successful_run_count": { "type": "integer", "minimum": 0 },
        "member_indices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "noise_seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "aggregates": { "$ref": "#/$defs/aggregate_map" },
        "robustness_summary": { "$ref": "#/$defs/robustness_summary" }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": [
        "run_id",
        "ensemble_id",
        "member_index",
        "noise_seed",
        "param_set_hash",
        "status",
        "observables",
        "provenance"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "ensemble_id": { "type": "string", "minLength": 1 },
        "member_index": { "type": "integer", "minimum": 0 },
        "noise_seed": { "type": "integer" },
        "param_set_hash": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "observables": { "$ref": "#/$defs/observable_map" },
        "provenance": {
          "type": "object",
          "required": [
            "schema_version",
            "experiment",
            "seeds",
            "noise",
            "determinism",
            "ensemble",
            "initialization"
          ],
          "properties": {
            "schema_version": { "type": "string", "minLength": 1 },
            "experiment": {
              "type": "object",
              "required": ["base_case_hash"],
              "properties": {
                "base_case_hash": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "seeds": {
              "type": "object",
              "required": [
                "master_seed",
                "noise_seed",
                "initial_condition",
                "vortex_seed_count"
              ],
              "properties": {
                "master_seed": { "type": "integer" },
                "noise_seed": { "type": "integer" },
                "initial_condition": { "type": "string", "minLength": 1 },
                "vortex_seed_count": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "noise": {
              "type": "object",
              "required": [
                "enabled",
                "strength",
                "seed",
                "contract_kind",
                "sampling"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "strength": { "type": "number" },
                "seed": { "type": "integer" },
                "contract_kind": { "type": "string", "minLength": 1 },
                "sampling": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "determinism": {
              "type": "object",
              "required": [
                "noise_enabled",
                "deterministic_expected",
                "master_seed",
                "noise_seed",
                "pinning_seed",
                "reproducibility_scope"
              ],
              "properties": {
                "noise_enabled": { "type": "boolean" },
                "deterministic_expected": { "type": "boolean" },
                "master_seed": { "type": "integer" },
                "noise_seed": { "type": "integer" },
                "pinning_seed": { "type": ["integer", "null"] },
                "reproducibility_scope": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "ensemble": {
              "type": "object",
              "required": [
                "mode",
                "member_count",
                "master_seed",
                "parent_manifest_hash"
              ],
              "properties": {
                "mode": { "const": "stochastic_ensemble" },
                "member_count": { "type": "integer", "minimum": 1 },
                "master_seed": { "type": "integer" },
                "parent_manifest_hash": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "initialization": {
              "type": "object",
              "required": [
                "mode",
                "configured_vortex_seeds",
                "resolved_vortex_seeds",
                "seed_resolution_policy",
                "seed_rejection_taxonomy_version"
              ],
              "properties": {
                "mode": { "type": "string", "minLength": 1 },
                "configured_vortex_seeds": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/seed_payload" }
                },
                "resolved_vortex_seeds": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/seed_payload" }
                },
                "seed_resolution_policy": { "type": "string", "minLength": 1 },
                "seed_rejection_taxonomy_version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
