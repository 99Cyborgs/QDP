  "rules": [
    {
      "rule_id": "RUNTIME_NO_LOSS_001",
      "title": "No loss preservation for execution bearing runtime text",
      "normative_source": [
        "specs/core/build_spec.md"
      ],
      "required_behavior": "No future runtime assembly may replace detailed operational sections with shorthand references to prior versions.",
      "enforcement_bindings": [
        {
          "class": "PROMPT_ONLY",
          "implementation": "runtime/current/runtime_prompt.md must contain full retained sections explicitly",
          "status": "BLOCKED_BY_MISSING_SOURCE"
        },
        {
          "class": "HARNESS_ENFORCED",
          "implementation": "modules/m06_bootstrap_harness/runner.py checks runtime prompt presence, forbidden shorthand, and mandatory retained section presence when the runtime artifact exists",
          "status": "BOUND"
        }
      ],
      "coverage_status": "BLOCKED_BY_MISSING_SOURCE"
    },
    {
      "rule_id": "RUNTIME_BUILD_002",
      "title": "Authoritative runtime is additive composition, not summary substitution",
      "normative_source": [
        "specs/core/build_spec.md"
      ],
      "required_behavior": "The authoritative runtime equals retained v10.1 operative text plus deterministic control patches plus harness plus diagnostics plus post run validation plus typed self checks.",
      "enforcement_bindings": [
        {
          "class": "PROMPT_ONLY",
          "implementation": "runtime/current/runtime_prompt.md assembly process",
          "status": "BLOCKED_BY_MISSING_SOURCE"
        },
        {
          "class": "MANUAL_REVIEW_ONLY",
          "implementation": "Patch notes and closure report inspection",
          "status": "PARTIALLY_BOUND"
        }
      ],
      "coverage_status": "PARTIALLY_BOUND"
    },
    {
      "rule_id": "REFERENCE_STRICT_003",
      "title": "Strict reference resolution for retained and canonical references",
      "normative_source": [
        "config/manifests/reference_manifest.json",
        "specs/core/build_spec.md"
